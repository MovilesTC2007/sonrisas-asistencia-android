<full-backup-content>
    <!-- La llave del Keystore no viaja con el respaldo, asi que restaurar este
         archivo en otro dispositivo solo dejaria un cifrado indescifrable. -->
    <exclude domain="sharedpref" path="auth_secure_prefs.xml"/>
</full-backup-content>