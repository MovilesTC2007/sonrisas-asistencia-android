<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Compose owns all real theming (ui/theme/Theme.kt). This XML theme only
         covers what draws before Compose's first frame: window background and
         system bars, so there's no white/black flash on launch. -->
    <style name="Theme.SonrisasAsistencias" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg_cream</item>
        <item name="android:statusBarColor">@color/bg_cream</item>
        <item name="android:navigationBarColor">@color/bg_cream</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
